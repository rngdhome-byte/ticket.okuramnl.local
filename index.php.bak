// ==========================================
// API HANDLERS (Database Actions)
// ==========================================
if ($_SERVER['REQUEST_METHOD'] === 'GET' && isset($_GET['action']) && $_GET['action'] === 'get_logs') {
    if (!isset($_SESSION['authenticated']) || $_SESSION['authenticated'] !== true) {
        http_response_code(403); die(json_encode(['error' => 'Unauthorized']));
    }
    $stmt = $pdo->query("SELECT id, ticket_number as ticketNumber, log_type as type, status, concern_category as concern, sub_category as subCategory, requestor_type as requestorType, department, requestor_specific as requestorSpecific, title, logged_by as user, message, date, time, timestamp_val as timestamp FROM tickets ORDER BY timestamp_val DESC");
    die(json_encode($stmt->fetchAll()));
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $raw_data = file_get_contents('php://input');
    $json_data = json_decode($raw_data, true);
    
    if (isset($json_data['action'])) {
        if (!isset($_SESSION['authenticated']) || $_SESSION['authenticated'] !== true) {
            http_response_code(403); die(json_encode(['error' => 'Unauthorized']));
        }
        
        // Save or Update Log
        if ($json_data['action'] === 'save_log') {
            $log = $json_data['log'];
            if (!empty($log['editId'])) {
                $stmt = $pdo->prepare("UPDATE tickets SET log_type=:type, status=:status, concern_category=:concern, sub_category=:subCategory, requestor_type=:requestorType, department=:department, requestor_specific=:requestorSpecific, title=:title, message=:message WHERE id=:id");
                $stmt->execute([
                    ':type' => $log['type'], ':status' => $log['status'], ':concern' => $log['concern'],
                    ':subCategory' => $log['subCategory'], ':requestorType' => $log['requestorType'],
                    ':department' => $log['department'], ':requestorSpecific' => $log['requestorSpecific'],
                    ':title' => $log['title'], ':message' => $log['message'], ':id' => $log['editId']
                ]);
            } else {
                $stmt = $pdo->prepare("INSERT INTO tickets (ticket_number, log_type, status, concern_category, sub_category, requestor_type, department, requestor_specific, title, logged_by, message, date, time, timestamp_val) VALUES (:ticketNumber, :type, :status, :concern, :subCategory, :requestorType, :department, :requestorSpecific, :title, :user, :message, :date, :time, :timestamp)");
                $stmt->execute([
                    ':ticketNumber' => $log['ticketNumber'], ':type' => $log['type'], ':status' => $log['status'],
                    ':concern' => $log['concern'], ':subCategory' => $log['subCategory'],
                    ':requestorType' => $log['requestorType'], ':department' => $log['department'],
                    ':requestorSpecific' => $log['requestorSpecific'], ':title' => $log['title'],
                    ':user' => $_SESSION['username'], ':message' => $log['message'],
                    ':date' => $log['date'], ':time' => $log['time'], ':timestamp' => $log['timestamp']
                ]);
            }
            die(json_encode(['status' => 'success']));
        }

        // Delete Log
        if ($json_data['action'] === 'delete_log') {
            if (!isset($_SESSION['is_superadmin']) || $_SESSION['is_superadmin'] !== true) {
                http_response_code(403); die(json_encode(['error' => 'Forbidden']));
            }
            $stmt = $pdo->prepare("DELETE FROM tickets WHERE id = :id");
            $stmt->execute([':id' => $json_data['id']]);
            die(json_encode(['status' => 'success']));
        }

        // Clear All Logs
        if ($json_data['action'] === 'clear_logs') {
            if (!isset($_SESSION['is_superadmin']) || $_SESSION['is_superadmin'] !== true) {
                http_response_code(403); die(json_encode(['error' => 'Forbidden']));
            }
            $pdo->query("TRUNCATE TABLE tickets");
            die(json_encode(['status' => 'success']));
        }
        
        // Save Settings
        if ($json_data['action'] === 'save_settings') {
            if (!isset($_SESSION['can_manage']) || $_SESSION['can_manage'] !== true) {
                http_response_code(403); die(json_encode(['error' => 'Forbidden']));
            }
            file_put_contents($settings_file, json_encode($json_data['settings'], JSON_PRETTY_PRINT));
            die(json_encode(['status' => 'success']));
        }

        // Save Profile
        if ($json_data['action'] === 'save_profile') {
            $profiles = json_decode(file_get_contents($profiles_file), true);
            $profiles[$_SESSION['username']] = $json_data['image'];
            file_put_contents($profiles_file, json_encode($profiles, JSON_PRETTY_PRINT));
            die(json_encode(['status' => 'success']));
        }
    }
}

// Handle Auth Logs Fetch (Superadmin Only)
if ($_SERVER['REQUEST_METHOD'] === 'GET' && isset($_GET['action']) && $_GET['action'] === 'get_auth_logs') {
    if (!isset($_SESSION['is_superadmin']) || $_SESSION['is_superadmin'] !== true) {
        http_response_code(403); die("Unauthorized");
    }
    if (file_exists('auth.log')) {
        $lines = file('auth.log', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        die(json_encode(['logs' => array_reverse($lines)]));
    }
    die(json_encode(['logs' => ["No activity recorded yet."]]));
}

// Read Current Data
$current_settings_json = file_get_contents($settings_file);
$current_profiles_json = file_get_contents($profiles_file);

// Preload Tickets from DB for Initial Page Load
$stmt = $pdo->query("SELECT id, ticket_number as ticketNumber, log_type as type, status, concern_category as concern, sub_category as subCategory, requestor_type as requestorType, department, requestor_specific as requestorSpecific, title, logged_by as user, message, date, time, timestamp_val as timestamp FROM tickets ORDER BY timestamp_val DESC");
$current_logs_json = json_encode($stmt->fetchAll());

// Extract Customization Settings
$settings_arr = json_decode($current_settings_json, true);
$default_logo = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%238957e5'><path d='M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.67-3.13 8.9-7 10.02-3.87-1.12-7-5.35-7-10.02V6.3l7-3.12zm0 1.82a4 4 0 00-4 4c0 2.21 1.79 4 4 4s4-1.79 4-4-1.79-4-4-4zm0 2a2 2 0 110 4 2 2 0 010-4z'/></svg>";
$logo_img = (!empty($settings_arr['logoImage'])) ? $settings_arr['logoImage'] : $default_logo;
$bg_img = (!empty($settings_arr['bgImage'])) ? $settings_arr['bgImage'] : "";

// ==========================================
// HANDLE LOGIN SUBMISSION
// ==========================================
$error = "";
if (isset($_GET['timeout'])) { $error = "Session expired due to inactivity. Please log in again."; }

if (isset($_POST['username']) && isset($_POST['password'])) {
    $user = $_POST['username'];
    $pass = $_POST['password'];
    $ldap_user = $user . $ldap_domain;
    $ldap_conn = @ldap_connect($ldap_host);
    
    if ($ldap_conn) {
        ldap_set_option($ldap_conn, LDAP_OPT_PROTOCOL_VERSION, 3);
        ldap_set_option($ldap_conn, LDAP_OPT_REFERRALS, 0);

        if (@ldap_bind($ldap_conn, $ldap_user, $pass)) {
            $filter = "(sAMAccountName=" . $user . ")";
            $attributes = array("memberof");
            $search = @ldap_search($ldap_conn, $ldap_base_dn, $filter, $attributes);
            $entries = @ldap_get_entries($ldap_conn, $search);
            
            $is_authorized = false;
            if ($entries["count"] > 0 && isset($entries[0]["memberof"])) {
                $memberof = $entries[0]["memberof"];
                for ($i = 0; $i < $memberof["count"]; $i++) {
                    if (strcasecmp($memberof[$i], $allowed_group) == 0) { $is_authorized = true; break; }
                }
            }

            if ($is_authorized) {
                session_regenerate_id(true); // Security update
                $_SESSION['authenticated'] = true;
                $_SESSION['username'] = $user;
                $_SESSION['LAST_ACTIVITY'] = time();
                
                $lower_user = strtolower($user);
                
                $_SESSION['is_superadmin'] = in_array($lower_user, array_map('strtolower', $allowed_superadmins));
                $_SESSION['is_admin'] = in_array($lower_user, array_map('strtolower', $allowed_admins));
                $_SESSION['can_manage'] = $_SESSION['is_superadmin'] || $_SESSION['is_admin'];

                log_auth_attempt($user, "SUCCESS");
                header("Location: index.php");
                exit;
            } else { 
                $error = "Access Denied!"; 
                log_auth_attempt($user, "DENIED - Not in Group");
            }
        } else { 
            $error = "Invalid Username or Password."; 
            log_auth_attempt($user, "FAILED - Wrong Password");
        }
        ldap_close($ldap_conn);
    } else { $error = "Could not connect to Domain Controller."; }
}

if (!isset($_SESSION['authenticated']) || $_SESSION['authenticated'] !== true) {
