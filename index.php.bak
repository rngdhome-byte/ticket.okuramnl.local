        input[readonly] { background-color: #161b22; color: #8b949e; cursor: not-allowed; border-color: #30363d; font-weight: bold;}
        textarea { resize: vertical; min-height: 80px; }
        
        .btn-submit { background-color: var(--info-color); color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; align-self: flex-start; }
        .btn-submit:hover { background-color: #7a4dd1; }
        .btn-cancel-edit { background-color: transparent; color: #8b949e; border: 1px solid #8b949e; padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; display: none;}
        .btn-cancel-edit:hover { background-color: rgba(255,255,255,0.1); color: white;}
        .form-actions { display: flex; gap: 1rem; }

        /* DASHBOARD STATS */
        .summary-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
        .stat-card { background: rgba(22, 27, 34, 0.9); backdrop-filter: blur(8px); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .stat-card h3 { font-size: 0.85rem; color: #8b949e; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;}
        .stat-card .number { font-size: 2.2rem; font-weight: bold; }
        .stat-total .number { color: var(--primary-color); }
        .stat-pending .number { color: var(--danger-color); }
        .stat-inprogress .number { color: var(--warning-color); }
        .stat-resolved .number { color: var(--success-color); }

        /* CONTROLS & FILTERS */
        .controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; gap: 1rem; flex-wrap: wrap; }
        .controls input[type="text"] { flex: 1; min-width: 250px; }
        .filter-group { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
        .filter-group select, .filter-group input[type="date"] { padding: 0.6rem; min-width: 140px; font-size: 0.85rem;}
        
        .btn-outline { background: rgba(1, 4, 9, 0.8); border: 1px solid var(--border-color); color: var(--text-color); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
        .btn-outline:hover { background: rgba(255,255,255,0.1); }
        .btn-danger-outline { background: rgba(1, 4, 9, 0.8); border: 1px solid var(--danger-color); color: var(--danger-color); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; transition: 0.2s; font-size: 0.85rem; }
        .btn-danger-outline:hover { background: rgba(248, 81, 73, 0.1); }
        .controls-actions { display: flex; gap: 0.5rem; margin-left: auto; flex-wrap: wrap; }

        /* TIMELINE */
        .log-feed { display: flex; flex-direction: column; gap: 1rem; }
        .log-entry { background: rgba(22, 27, 34, 0.9); backdrop-filter: blur(8px); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.2rem; display: flex; gap: 1.5rem; transition: transform 0.2s; border-left: 4px solid #30363d; }
        .log-entry:hover { transform: translateX(4px); border-color: #484f58; }
        .log-meta { flex: 0 0 160px; display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: #8b949e; border-right: 1px solid var(--border-color); padding-right: 1rem; }
        .log-date { font-weight: bold; color: var(--text-color); }
        .log-time { font-family: monospace; }
        .log-user { margin-top: 0.5rem; display: flex; align-items: center; color: var(--primary-color); font-weight: 500;}
        .log-content { flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
        .log-header { display: flex; justify-content: space-between; align-items: flex-start; }
        .tag-group { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.4rem;}
        .log-title { font-weight: bold; font-size: 1.15rem; color: var(--text-color); margin-bottom: 0.25rem;}
        .log-message { font-size: 0.95rem; line-height: 1.5; white-space: pre-wrap; color: #c9d1d9; }
        
        .badge { padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.75rem; font-weight: bold; color: white; text-transform: uppercase; }
        .badge.Support { background-color: var(--danger-color); }
        .badge.Maintenance { background-color: var(--warning-color); }
        .badge.Update { background-color: var(--success-color); }
        .badge.Note { background-color: var(--info-color); }
        .secondary-badge { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;}
        
        /* STATUS BADGES */
        .status-badge { padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; border: 1px solid;}
        .status-Resolved { background: rgba(46, 160, 67, 0.15); color: #3fb950; border-color: rgba(46, 160, 67, 0.4); }
        .status-InProgress { background: rgba(210, 153, 34, 0.15); color: #d29922; border-color: rgba(210, 153, 34, 0.4); }
        .status-Pending { background: rgba(248, 81, 73, 0.15); color: #f85149; border-color: rgba(248, 81, 73, 0.4); }

        .action-btn { background: none; border: none; color: #8b949e; cursor: pointer; transition: 0.2s; font-size: 1.1rem; margin-left: 0.5rem;}
        .action-btn.edit:hover { color: var(--primary-color); }
        .action-btn.del:hover { color: var(--danger-color); }
        .empty-state { text-align: center; padding: 3rem; color: #8b949e; font-style: italic; border: 1px dashed var(--border-color); border-radius: 8px; background: rgba(22, 27, 34, 0.9); }

        /* MODAL STYLES */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; justify-content: center; align-items: center; z-index: 1000; overflow-y: auto; padding: 2rem;}
        .modal { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; width: 100%; max-width: 900px; box-shadow: 0 10px 40px rgba(0,0,0,0.8);}
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;}
        .modal-header h2 { color: var(--primary-color); font-size: 1.4rem; margin: 0;}
        .close-btn { background: none; border: none; color: #8b949e; font-size: 1.8rem; cursor: pointer; line-height: 1;}
        .close-btn:hover { color: var(--danger-color); }
        
        .dir-split { display: flex; gap: 2rem; }
        .dir-section { flex: 1; display: flex; flex-direction: column; gap: 1rem;}
        .dir-section h3 { font-size: 1rem; color: #c9d1d9; border-bottom: 1px dashed #30363d; padding-bottom: 0.5rem; margin-bottom: 0.5rem;}
        
        .mng-list { list-style: none; padding: 0; margin: 0; border: 1px solid var(--border-color); border-radius: 6px; max-height: 250px; overflow-y: auto; background: #010409;}
        .mng-list li { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 1rem; border-bottom: 1px solid #30363d; font-size: 0.9rem;}
        .mng-list li:last-child { border-bottom: none; }
        .mng-list li:hover { background: #161b22; }
        .mng-actions { display: flex; gap: 0.5rem; }
        .mng-btn { background: none; border: none; cursor: pointer; color: #8b949e; font-size: 1rem; transition: 0.2s;}
        .mng-btn:hover { color: var(--primary-color); }
        .mng-btn.del:hover { color: var(--danger-color); }
        .dept-header-actions { display: flex; justify-content: space-between; align-items: center; margin-top: -0.5rem; margin-bottom: 0.5rem;}

        /* TERMINAL FOR AUTH LOGS */
        .terminal { background: #010409; color: #3fb950; padding: 1rem; border-radius: 6px; font-family: monospace; height: 400px; overflow-y: auto; border: 1px solid #30363d; font-size: 0.85rem; line-height: 1.5; }
        .term-line { margin-bottom: 4px; border-bottom: 1px dashed rgba(255,255,255,0.05); padding-bottom: 4px; }
        .term-success { color: #3fb950; font-weight: bold; }
        .term-fail { color: #f85149; font-weight: bold; }

        @media (max-width: 768px) { .dir-split { flex-direction: column; } }
        .dash-footer { text-align: center; padding: 2rem 0; margin-top: 4rem; border-top: 1px solid var(--border-color); color: #8b949e; font-size: 0.85rem; position: relative; z-index: 1;}
    </style>
</head>
