    <script>
        let idleTime = 0;
        setInterval(() => {
            idleTime++;
            if (idleTime >= 5) { window.location.href = "index.php?logout=true&timeout=1"; } 
            else { fetch('index.php?action=ping'); }
        }, 60000); 
        ['mousemove', 'keydown', 'scroll', 'click'].forEach(evt => document.addEventListener(evt, () => idleTime = 0));

        // --- PERMISSIONS & DATA ---
        const isSuperAdmin = <?php echo $is_superadmin ? 'true' : 'false'; ?>;
        const isAdmin = <?php echo $is_admin ? 'true' : 'false'; ?>;
        const canManage = isSuperAdmin || isAdmin;
        const currentUser = "<?php echo htmlspecialchars($_SESSION['username']); ?>";
        
        let activityLogs = <?php echo $current_logs_json; ?>;
        let appSettings = <?php echo $current_settings_json; ?>;
        let userProfiles = <?php echo $current_profiles_json; ?>;

        function setFormDateTimeToNow() {
            const now = new Date();
            const d = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
            const t = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
            document.getElementById('logDate').value = d;
            document.getElementById('logTime').value = t;
        }
        setFormDateTimeToNow();

        function generateTicketNumber() {
            let maxNum = 0;
            for (let log of activityLogs) {
                if (log.ticketNumber && log.ticketNumber.startsWith('HORTS-')) {
                    let numPart = parseInt(log.ticketNumber.replace('HORTS-', ''), 10);
                    if (!isNaN(numPart) && numPart > maxNum) maxNum = numPart;
                }
            }
            return 'HORTS-' + String(maxNum + 1).padStart(6, '0');
        }

        const defaultAvatar = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%238b949e'><path d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>";
        if(userProfiles[currentUser]) document.getElementById('headerAvatar').src = userProfiles[currentUser];

        function compressAndProcessImage(file, maxWidth, callback) {
            if(!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let scale = 1;
                    if(img.width > maxWidth) scale = maxWidth / img.width;
                    canvas.width = img.width * scale; canvas.height = img.height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    const compression = maxWidth > 500 ? 0.5 : 0.9;
                    const dataUrl = canvas.toDataURL(file.type === 'image/png' ? 'image/png' : 'image/jpeg', compression);
                    callback(dataUrl);
                }
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }

        function uploadProfilePic(event) {
            compressAndProcessImage(event.target.files[0], 150, function(dataUrl) {
                document.getElementById('headerAvatar').src = dataUrl;
                userProfiles[currentUser] = dataUrl;
                renderLogs();
                fetch('index.php', { method: 'POST', body: JSON.stringify({action: 'save_profile', image: dataUrl}) });
            });
        }

        if(isSuperAdmin) {
            window.openThemeModal = function() { document.getElementById('themeModal').style.display = "flex"; }
            window.closeThemeModal = function() { document.getElementById('themeModal').style.display = "none"; }
            
            window.uploadThemeImage = function(event, settingKey, maxWidth) {
                const file = event.target.files[0];
                if (!file) return;
                document.querySelector('.btn-danger-outline[onclick="resetTheme()"]').innerText = "Compressing & Saving...";
                compressAndProcessImage(file, maxWidth, function(dataUrl) {
                    appSettings[settingKey] = dataUrl;
                    saveSettingsToServer().then(() => {
                        alert(settingKey === 'bgImage' ? "Background updated!" : "Logo updated!");
                        location.reload();
                    });
                });
            }
            window.resetTheme = function() {
                if(confirm("Remove custom logo and background?")) {
                    appSettings.logoImage = ""; appSettings.bgImage = "";
                    saveSettingsToServer().then(() => location.reload());
                }
            }
        }

        const categoryMap = {
            "Hardware": ["Mouse", "Keyboard", "Monitor", "Laptop", "Server", "Telephone", "Access Point", "Desktop", "POS", "Cashdrawers", "Printer", "Scanner", "TV"],
            "Software": ["Operating System", "Microsoft 365 Office", "MS Teams", "Zoom", "Sun System", "Miwa", "EDR"],
            "System Access": ["Password Reset", "Access Creation", "Access Deactivation", "Access Rights"],
            "Network": ["Slow Connection", "Wi-Fi Concerns", "Downtime", "No Internet"],
            "Other": ["General Configuration", "Security Incident", "Miscellaneous"]
        };

        const logForm = document.getElementById('addLogForm');
        const logFeed = document.getElementById('logFeed');
        const searchInput = document.getElementById('searchInput');
        const filterCategory = document.getElementById('filterCategory');
        const filterUser = document.getElementById('filterUser');
        const filterDate = document.getElementById('filterDate');
        const filterStatus = document.getElementById('filterStatus');

        function populateUserFilter() {
            const currentSelection = filterUser.value;
            filterUser.innerHTML = '<option value="All">All Users</option>';
            const uniqueUsers = [...new Set(activityLogs.map(log => log.user))].filter(Boolean).sort();
            uniqueUsers.forEach(user => { filterUser.innerHTML += `<option value="${user}">${user}</option>`; });
            if (uniqueUsers.includes(currentSelection)) filterUser.value = currentSelection;
        }

        function resetFilters() {
            searchInput.value = ''; filterCategory.value = 'All'; filterUser.value = 'All'; 
            filterDate.value = ''; filterStatus.value = 'All';
            renderLogs();
        }

        function updateSubCategory(selectedValue = "") {
            const concernSelect = document.getElementById('logConcern');
            const subSelect = document.getElementById('logSubCategory');
            subSelect.innerHTML = '<option value="" disabled selected>Select Sub Category...</option>';
            if (categoryMap[concernSelect.value]) {
                subSelect.disabled = false;
                categoryMap[concernSelect.value].sort().forEach(sub => {
                    const option = document.createElement('option'); option.value = sub; option.textContent = sub;
                    subSelect.appendChild(option);
                });
                if(selectedValue) subSelect.value = selectedValue;
            } else { subSelect.disabled = true; }
        }

        function updateDepartmentDropdown(selectedDept = "") {
            const type = document.getElementById('logRequestor').value;
            const dept = document.getElementById('logDepartment');
            const reqSub = document.getElementById('logRequestorSub');

            dept.innerHTML = '<option value="" disabled selected>Select Department...</option>';
            reqSub.innerHTML = '<option value="" disabled selected>Waiting for Dept...</option>';
            reqSub.disabled = true;

            let sourceMap = type === "Employee" ? appSettings.employeeDepartments : (type === "Guest" ? appSettings.guestDepartments : null);

            if (sourceMap) {
                dept.disabled = false;
                Object.keys(sourceMap).sort().forEach(d => { dept.innerHTML += `<option value="${d}">${d}</option>`; });
                if(selectedDept) dept.value = selectedDept;
            } else if (type === "N/A") {
                dept.disabled = false; dept.innerHTML += `<option value="IT | Finance Department">IT | Finance Department</option>`; dept.value = "IT | Finance Department";
                reqSub.disabled = false; reqSub.innerHTML = '<option value="Internal IT">Internal IT</option>'; reqSub.value = "Internal IT";
            } else { dept.disabled = true; }
        }

        function updateSpecificRequestor(selectedSub = "") {
            const type = document.getElementById('logRequestor').value;
            const dept = document.getElementById('logDepartment').value;
            const reqSub = document.getElementById('logRequestorSub');

            reqSub.innerHTML = '<option value="" disabled selected>Select Specific...</option>';
            let sourceMap = type === "Employee" ? appSettings.employeeDepartments : (type === "Guest" ? appSettings.guestDepartments : null);

            if (sourceMap && sourceMap[dept]) {
                reqSub.disabled = false;
                let sortedSubs = type === "Guest" ? sourceMap[dept].sort((a,b) => parseInt(a) - parseInt(b)) : sourceMap[dept].sort();
                sortedSubs.forEach(sub => {
                    const option = document.createElement('option'); option.value = sub; 
                    option.textContent = type === "Guest" ? `Room ${sub}` : sub; reqSub.appendChild(option);
                });
                if(selectedSub) reqSub.value = selectedSub;
            } else { reqSub.disabled = true; }
        }

        // --- NEW DATABASE FETCH FUNCTION ---
        async function fetchLogsFromDB() {
            try {
                const res = await fetch('index.php?action=get_logs');
                activityLogs = await res.json();
                populateUserFilter();
                renderLogs();
            } catch (e) {
                console.error("Failed to fetch logs", e);
            }
        }

        async function saveSettingsToServer() {
            try { await fetch('index.php', { method: 'POST', body: JSON.stringify({ action: 'save_settings', settings: appSettings }) }); } 
            catch (e) { console.error(e); }
        }

        logForm.addEventListener('submit', async function(e) {
            e.preventDefault(); 
            const editId = document.getElementById('editId').value;
            const dateInput = document.getElementById('logDate').value;
            const timeInput = document.getElementById('logTime').value;
            const customDateObj = new Date(`${dateInput}T${timeInput}`);

            const formattedDate = customDateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const formattedTime = customDateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

            // Determine Ticket Number
            let tktNum = generateTicketNumber();
            if (editId) {
                let existingLog = activityLogs.find(l => l.id == editId);
                tktNum = existingLog ? existingLog.ticketNumber : tktNum;
            }

            const logData = {
                editId: editId, 
                ticketNumber: tktNum,
                type: document.getElementById('logType').value,
                status: document.getElementById('logStatus').value,
                concern: document.getElementById('logConcern').value,
                subCategory: document.getElementById('logSubCategory').value,
                requestorType: document.getElementById('logRequestor').value,
                department: document.getElementById('logDepartment').value,
                requestorSpecific: document.getElementById('logRequestorSub').value,
                title: document.getElementById('logTitle').value,
                message: document.getElementById('logMessage').value,
                date: formattedDate,
                time: formattedTime,
                timestamp: customDateObj.getTime()
            };

            try {
                // Send to DB via API action
                await fetch('index.php', { method: 'POST', body: JSON.stringify({ action: 'save_log', log: logData }) });
                await fetchLogsFromDB();
                resetForm();
                cancelEdit();
            } catch (e) { console.error("Error saving to DB", e); }
        });

        function resetForm() {
            document.getElementById('editId').value = ''; document.getElementById('logTitle').value = '';
            document.getElementById('logMessage').value = ''; document.getElementById('logType').value = 'Support';
            document.getElementById('logStatus').value = 'Resolved';
            document.getElementById('logConcern').value = ''; updateSubCategory(); document.getElementById('logRequestor').value = '';
            updateDepartmentDropdown();
            setFormDateTimeToNow(); 
        }

        if (canManage) {
            window.editLog = function(id) {
                const log = activityLogs.find(l => l.id == id);
                if(!log) return;
                
                document.getElementById('formContainer').classList.add('edit-mode');
                document.getElementById('saveLogBtn').textContent = "Update Log Entry";
                document.getElementById('cancelEditBtn').style.display = "inline-block";
                
                document.getElementById('editId').value = log.id; 
                document.getElementById('logType').value = log.type;
                document.getElementById('logStatus').value = log.status || 'Resolved';
                document.getElementById('logConcern').value = log.concern; updateSubCategory(log.subCategory);
                document.getElementById('logRequestor').value = log.requestorType;
                updateDepartmentDropdown(log.department); updateSpecificRequestor(log.requestorSpecific);
                document.getElementById('logTitle').value = log.title; document.getElementById('logMessage').value = log.message;

                const logD = new Date(parseInt(log.timestamp));
                document.getElementById('logDate').value = logD.getFullYear() + '-' + String(logD.getMonth()+1).padStart(2,'0') + '-' + String(logD.getDate()).padStart(2,'0');
                document.getElementById('logTime').value = String(logD.getHours()).padStart(2,'0') + ':' + String(logD.getMinutes()).padStart(2,'0');

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            window.cancelEdit = function() {
                document.getElementById('formContainer').classList.remove('edit-mode');
                document.getElementById('saveLogBtn').textContent = "+ Save Log Entry";
                document.getElementById('cancelEditBtn').style.display = "none"; resetForm();
            }

            window.openSettingsModal = function() {
                const dl = document.getElementById('existingDepts'); dl.innerHTML = '';
                const allDepts = [...new Set([...Object.keys(appSettings.employeeDepartments), ...Object.keys(appSettings.guestDepartments)])].sort();
                allDepts.forEach(d => dl.innerHTML += `<option value="${d}">`);
                renderMngDepts();
                document.getElementById('settingsModal').style.display = "flex";
            }
            window.closeSettingsModal = function() { document.getElementById('settingsModal').style.display = "none"; }
            
            document.getElementById('settingsForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const type = document.getElementById('setReqType').value;
                const dept = document.getElementById('setDept').value.trim();
                const spec = document.getElementById('setSpecific').value.trim();
                let targetMap = type === "Employee" ? appSettings.employeeDepartments : appSettings.guestDepartments;
                
                if (!targetMap[dept]) targetMap[dept] = []; 
                if (!targetMap[dept].includes(spec)) {
                    targetMap[dept].push(spec); saveSettingsToServer(); alert(`Added ${spec} to ${dept}!`);
                } else { alert(`${spec} already exists in ${dept}.`); }

                document.getElementById('setSpecific').value = '';
                renderMngDepts(); 
                if(document.getElementById('logRequestor').value === type) {
                    updateDepartmentDropdown(document.getElementById('logDepartment').value);
                    updateSpecificRequestor(document.getElementById('logRequestorSub').value);
                }
            });

            window.renderMngDepts = function() {
                const type = document.getElementById('mngType').value;
                const deptSelect = document.getElementById('mngDept');
                deptSelect.innerHTML = '<option value="" disabled selected>Select Department to Edit...</option>';
                const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                Object.keys(map).sort().forEach(d => { deptSelect.innerHTML += `<option value="${d}">${d}</option>`; });
                document.getElementById('mngItemList').innerHTML = '<li>Select a department to view members.</li>';
            }

            window.renderMngItems = function() {
                const type = document.getElementById('mngType').value;
                const dept = document.getElementById('mngDept').value;
                const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                const list = document.getElementById('mngItemList');
                list.innerHTML = '';
                if(!map[dept] || map[dept].length === 0) { list.innerHTML = '<li>No members found.</li>'; return; }
                
                let sortedSubs = type === "Guest" ? map[dept].sort((a,b) => parseInt(a) - parseInt(b)) : map[dept].sort();
                sortedSubs.forEach(item => {
                    let delBtn = isSuperAdmin ? `<button type="button" class="mng-btn del" onclick="deleteDirItem('${type}', '${dept}', '${item}')" title="Delete">???</button>` : '';
                    list.innerHTML += `
                        <li>
                            <span>${type === 'Guest' ? 'Room ' : ''}${item}</span>
                            <div class="mng-actions">
                                <button type="button" class="mng-btn" onclick="renameDirItem('${type}', '${dept}', '${item}')" title="Rename">??</button>
                                ${delBtn}
                            </div>
                        </li>
                    `;
                });
            }

            window.renameDirDept = function() {
                const type = document.getElementById('mngType').value;
                const oldDept = document.getElementById('mngDept').value;
                if(!oldDept) return alert("Select a department first.");
                const newDept = prompt("Enter new department name:", oldDept);
                if(!newDept || newDept === oldDept) return;
                
                const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                if(map[newDept]) return alert("Department name already exists!");
                
                map[newDept] = map[oldDept]; delete map[oldDept];
                saveSettingsToServer(); renderMngDepts();
                if(document.getElementById('logRequestor').value === type) updateDepartmentDropdown(document.getElementById('logDepartment').value);
            }

            window.renameDirItem = function(type, dept, oldName) {
                const newName = prompt(`Rename '${oldName}' to:`, oldName);
                if(!newName || newName === oldName) return;
                const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                const idx = map[dept].indexOf(oldName);
                if(idx > -1) {
                    map[dept][idx] = newName.trim();
                    saveSettingsToServer(); renderMngItems();
                    if(document.getElementById('logRequestor').value === type) updateSpecificRequestor(document.getElementById('logRequestorSub').value);
                }
            }
        }

        if (isSuperAdmin) {
            window.deleteLog = async function(id) {
                if(confirm("Are you sure you want to delete this log entry?")) {
                    await fetch('index.php', { method: 'POST', body: JSON.stringify({ action: 'delete_log', id: id }) });
                    await fetchLogsFromDB();
                }
            }
            window.clearAllLogs = async function() {
                if(activityLogs.length === 0) return;
                if(confirm("CRITICAL WARNING: This will permanently delete ALL logs on the server. Are you sure?")) {
                    await fetch('index.php', { method: 'POST', body: JSON.stringify({ action: 'clear_logs' }) });
                    await fetchLogsFromDB();
                }
            }
            window.deleteDirDept = function() {
                const type = document.getElementById('mngType').value;
                const dept = document.getElementById('mngDept').value;
                if(!dept) return alert("Select a department first.");
                if(confirm(`Are you sure you want to delete the entire '${dept}' department?`)) {
                    const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                    delete map[dept]; saveSettingsToServer(); renderMngDepts();
                    if(document.getElementById('logRequestor').value === type) updateDepartmentDropdown(document.getElementById('logDepartment').value);
                }
            }
            window.deleteDirItem = function(type, dept, name) {
                if(confirm(`Delete '${name}' from ${dept}?`)) {
                    const map = type === 'Employee' ? appSettings.employeeDepartments : appSettings.guestDepartments;
                    map[dept] = map[dept].filter(i => i !== name);
                    saveSettingsToServer(); renderMngItems();
                    if(document.getElementById('logRequestor').value === type) updateSpecificRequestor(document.getElementById('logRequestorSub').value);
                }
            }
            window.openAuthLogsModal = async function() {
                document.getElementById('authLogsModal').style.display = "flex";
                const term = document.getElementById('authTerminalOutput');
                term.innerHTML = "Fetching authentication records...";
                try {
                    const res = await fetch('index.php?action=get_auth_logs');
                    const data = await res.json();
                    if(data.logs && data.logs.length > 0) {
                        term.innerHTML = data.logs.map(line => {
                            let formatLine = line;
                            if(line.includes("SUCCESS")) formatLine = line.replace("SUCCESS", "<span class='term-success'>SUCCESS</span>");
                            else if(line.includes("FAILED") || line.includes("DENIED")) formatLine = line.replace(/(FAILED[^\|]*|DENIED[^\|]*)/, "<span class='term-fail'>$1</span>");
                            return `<div class="term-line">${formatLine}</div>`;
                        }).join('');
                    }
                } catch(e) { term.innerHTML = "Error loading logs."; }
            }
            window.closeAuthLogsModal = function() { document.getElementById('authLogsModal').style.display = "none"; }
        }

        // --- FILTER LOGIC CORE ---
        function getFilteredLogs() {
            const searchTerm = searchInput.value.toLowerCase();
            const filterCat = filterCategory.value;
            const filterUsr = filterUser.value; 
            const filterDateVal = filterDate.value; 
            const filterStatVal = filterStatus.value;

            return activityLogs.filter(log => {
                const tktStr = log.ticketNumber || "";
                const searchString = `${tktStr} ${log.title} ${log.message} ${log.user} ${log.concern} ${log.subCategory||""} ${log.requestorType} ${log.requestorSpecific||""} ${log.department||""}`.toLowerCase();
                const matchesSearch = searchString.includes(searchTerm);
                const matchesCategory = filterCat === "All" || log.type === filterCat;
                const matchesUser = filterUsr === "All" || log.user === filterUsr;
                const matchesStatus = filterStatVal === "All" || (log.status || "Resolved") === filterStatVal;
                
                let matchesDate = true;
                if (filterDateVal) {
                    const d = new Date(parseInt(log.timestamp));
                    const localISO = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, '0') + "-" + String(d.getDate()).padStart(2, '0');
                    matchesDate = (localISO === filterDateVal);
                }
                return matchesSearch && matchesCategory && matchesUser && matchesDate && matchesStatus;
            });
        }

        // --- EXPORT TO EXCEL / CSV ---
        window.exportToCSV = function() {
            const logsToExport = getFilteredLogs();
            if (logsToExport.length === 0) {
                alert("No logs to export based on current filters.");
                return;
            }

            let csvContent = "Ticket Number,Date,Time,Log Type,Status,Concern Category,Sub Category,Requestor Type,Department,Specific Requestor,Title,Logged By,Details\n";

            logsToExport.forEach(log => {
                const cleanTitle = `"${(log.title || '').replace(/"/g, '""')}"`;
                const cleanMessage = `"${(log.message || '').replace(/"/g, '""')}"`;

                let row = [
                    log.ticketNumber || 'N/A',
                    log.date,
                    log.time,
                    log.type,
                    log.status || 'Resolved',
                    log.concern,
                    log.subCategory || 'N/A',
                    log.requestorType,
                    log.department || 'N/A',
                    log.requestorSpecific || 'N/A',
                    cleanTitle,
                    log.user,
                    cleanMessage
                ];
                csvContent += row.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `IT_Logs_Report_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // --- RENDER UI ---
        function renderLogs() {
            const filteredLogs = getFilteredLogs();
            
            let total = 0, pendingCount = 0, inProgressCount = 0, resolvedCount = 0;
            
            filteredLogs.forEach(log => {
                total++;
                let s = log.status || "Resolved";
                if (s === "Pending") pendingCount++;
                else if (s === "In Progress") inProgressCount++;
                else if (s === "Resolved") resolvedCount++;
            });

            document.getElementById('countTotal').innerText = total;
            document.getElementById('countPending').innerText = pendingCount;
            document.getElementById('countInProgress').innerText = inProgressCount;
            document.getElementById('countResolved').innerText = resolvedCount;

            logFeed.innerHTML = '';
            if (filteredLogs.length === 0) {
                logFeed.innerHTML = `<div class="empty-state">No logs match your filter criteria.</div>`; return;
            }

            filteredLogs.forEach(log => {
                let borderColor = "#30363d";
                if(log.type === "Support") borderColor = "var(--danger-color)";
                if(log.type === "Maintenance") borderColor = "var(--warning-color)";
                if(log.type === "Update") borderColor = "var(--success-color)";
                if(log.type === "Note") borderColor = "var(--info-color)";

                let reqDisplay = log.requestorType === 'N/A' ? 'Internal IT' : (log.requestorType === 'Guest' ? `Room ${log.requestorSpecific}` : log.requestorSpecific);
                
                let actionHtml = '';
                if (canManage) {
                    let editBtn = `<button class="action-btn edit" onclick="editLog(${log.id})" title="Edit Log">??</button>`;
                    let delBtn = isSuperAdmin ? `<button class="action-btn del" onclick="deleteLog(${log.id})" title="Delete Log">???</button>` : '';
                    actionHtml = `<div>${editBtn}${delBtn}</div>`;
                }

                const avatarSrc = userProfiles[log.user] ? userProfiles[log.user] : defaultAvatar;
                const ticketHtml = log.ticketNumber ? `<span style="color: var(--primary-color); margin-right: 0.5rem; font-family: monospace;">[${log.ticketNumber}]</span>` : '';

                let statusVal = log.status || "Resolved";
                let statusClass = statusVal.replace(/\s+/g, '');
                let statusHtml = `<span class="status-badge status-${statusClass}">${statusVal}</span>`;

                const logElement = document.createElement('div');
                logElement.className = 'log-entry';
                logElement.style.borderLeftColor = borderColor;
                
                logElement.innerHTML = `
                    <div class="log-meta">
                        <span class="log-date">${log.date}</span>
                        <span class="log-time">${log.time}</span>
                        <span class="log-user"><img src="${avatarSrc}" class="feed-avatar">${log.user}</span>
                    </div>
                    <div class="log-content">
                        <div class="log-header">
                            <div style="width: 100%;">
                                <div class="tag-group">
                                    ${statusHtml}
                                    <span class="badge ${log.type}">${log.type}</span>
                                    <span class="secondary-badge">${log.concern}</span>
                                    ${log.subCategory ? `<span class="secondary-badge">${log.subCategory}</span>` : ''}
                                    <span class="secondary-badge" style="background: #1c2128; border-color: #484f58; color: #c9d1d9;">?? Req: ${reqDisplay}</span>
                                    ${log.department ? `<span class="secondary-badge" style="background: #232b36; border-color: #8957e5; color: #c9d1d9;">?? Dept: ${log.department}</span>` : ''}
                                </div>
                                <div class="log-title">${ticketHtml}${log.title}</div>
                            </div>
                            ${actionHtml}
                        </div>
                        <div class="log-message">${log.message}</div>
                    </div>
                `;
                logFeed.appendChild(logElement);
            });
        }

        searchInput.addEventListener('input', renderLogs);
        filterCategory.addEventListener('change', renderLogs);
        filterUser.addEventListener('change', renderLogs); 
        filterDate.addEventListener('change', renderLogs); 
        filterStatus.addEventListener('change', renderLogs);
        
        populateUserFilter();
        renderLogs();

    </script>
</body>
</html>